# ===== API (FastAPI) =====
APP_NAME=UrjaSetu
APP_ENV=testnet-demo
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVICE_AUTH_SECRET=change-me-device
DATABASE_URL=postgresql+psycopg2://urjasetu:urjasetu_secret@db:5432/urjasetu
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ===== Payment Gateway (x402, self-facilitated) =====
PAYMENT_GATEWAY_PORT=3001
X402_VERSION=2
X402_SCHEME=exact
OPTIMIZATION_PRICE=0.01
PAYMENT_ASSET=USDC
# Self-facilitation: the gateway runs the x402 facilitator in-process.
# Use the gateway's own facility URL (docker network hostname below).
FACILITATOR_URL=http://payment-gateway:3001/facilitator
# Throwaway-testnet mode generates a fee-payer account at startup (testnet demo only).
PAYMENT_TEST_MODE=false

# ===== Algorand =====
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
# Receiver — where USDC payments are sent (MUST be a funded Testnet address)
RECEIVER_ALGORAND_ADDRESS=
# Facilitator fee-payer account (base64 64-byte key: 32-byte seed + 32-byte pubkey).
# Required unless PAYMENT_TEST_MODE=true.
FACILITATOR_PRIVATE_KEY=

# ===== Web =====
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_PAYMENT_GATEWAY_URL=http://localhost:3001

# ===== MQTT =====
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ===== Demo =====
DEMO_MODE=true
TELEMETRY_FRESHNESS_S=20